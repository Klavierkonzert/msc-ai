{
    "version": "0.2.0",
    "type": "cppbuild",
    "label": "C/C++: g++.exe build active file",
    "command": "C:\\msys64\\ucrt64\\bin\\g++.exe",
    "args": [
        "-fdiagnostics-color=always",
        "-g",
        "-std=c++20",
        "-fopenmp",
        "-I${env:USERPROFILE}\\source\\repos\\matplotlib-cpp",
        "-I${env:USERPROFILE}\\.conda_envs\\rl_env\\Include",
        "-I${env:USERPROFILE}\\.conda_envs\\rl_env\\Lib\\site-packages\\numpy\\_core\\include",
        "${file}",
        "-L${env:USERPROFILE}\\.conda_envs\\rl_env\\libs",
        "-lpython313",
        "-o",
        "${fileDirname}\\${fileBasenameNoExtension}.exe",
        "-parallel"
    ],
    "options": {
        "cwd": "${fileDirname}"
    },
    "problemMatcher": [
        "$gcc"
    ],
    "group": {
        "kind": "build",
        "isDefault": false
    },
    "detail": "Task generated by Debugger.",
    "configurations": [
        {
            "name": "C/C++: cl.exe build and debug active file",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${fileDirname}\\${fileBasenameNoExtension}.exe",
            "args": [
                "--parallel",
                "--no-windows",
                "--tasks",
                "2,345"
            ],
            "stopAtEntry": false,
            "cwd": "${fileDirname}",
            "environment": [],
            "console": "integratedTerminal",
            "preLaunchTask": "C/C++: cl.exe build active file"
        }
    ]
}