{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe build active file",
            "command": "C:\\msys64\\ucrt64\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "-std=c++20",
                "-fopenmp",
                    "-I${env:USERPROFILE}\\source\\repos\\matplotlib-cpp",
                    "-I${env:USERPROFILE}\\.conda_envs\\rl_env\\Include",
                    "-I${env:USERPROFILE}\\.conda_envs\\rl_env\\Lib\\site-packages\\numpy\\_core\\include",
                "${file}",
                    "-L${env:USERPROFILE}\\.conda_envs\\rl_env\\libs",
                    "-lpython313",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "Task generated by Debugger."
        },
        {
            "type": "cppbuild",
            "label": "C/C++: cl.exe build active file",
            "command": "cl.exe",
            "args": [
                "/Zi",
                "/EHsc",
                "/std:c++20",
                "/openmp",
                "/nologo",
                    "/I${env:USERPROFILE}\\source\\repos\\matplotlib-cpp",
                    "/I${env:USERPROFILE}\\.conda_envs\\rl_env\\Include",
                    "/I${env:USERPROFILE}\\.conda_envs\\rl_env\\Lib\\site-packages\\numpy\\_core\\include",
                "/Fe${fileDirname}\\${fileBasenameNoExtension}.exe",
                    "${file}",
                    "/link",
                    "/LIBPATH:${env:USERPROFILE}\\.conda_envs\\rl_env\\libs",
                    "python313.lib"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ],
