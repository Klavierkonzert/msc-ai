      <bpmn2:userTask id="_EFBE26BA-69B6-43B5-8C3F-7ADBE7B7D4CD" name="Loot corpses">
        <bpmn2:documentation id="_i-30ZkikEfGDnvGeD6FIDw"><![CDATA[The ‘Loot corpses’ task allows the user to select collected items. The selected values are stored in a temporary variable and subsequently merged into the global quest variable quest.loot, which is modeled as a list of strings.]]></bpmn2:documentation>
        <bpmn2:extensionElements>
          <drools:metaData name="elementname">
            <drools:metaValue><![CDATA[Loot corpses]]></drools:metaValue>
          </drools:metaData>
          <drools:onExit-script scriptFormat="http://www.java.com/java">
            <drools:script><![CDATA[com.myspace.witcherquest.Quest q =
    (com.myspace.witcherquest.Quest) kcontext.getVariable("quest");

q.addLoot(lootedItems);
q.print("DEBUG (LOOTING EXIT): ");]]></drools:script>
          </drools:onExit-script>
        </bpmn2:extensionElements>
