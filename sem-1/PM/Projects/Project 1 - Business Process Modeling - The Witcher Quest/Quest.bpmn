      <bpmn2:userTask id="_8DE5914F-3E8D-4FF6-8FB4-E1E783BFDA84" name="Move with Letho">
        <bpmn2:documentation id="_i-30dkikEfGDnvGeD6FIDw"><![CDATA[The ‘Move with Letho’ task captures the outcome of following Letho. Based on the time of following Letho, it's determined whether the player successfully continues the quest or loses Letho, resulting in early termination.

The task will be cancelled once boundary timer expires]]></bpmn2:documentation>
        <bpmn2:extensionElements>
          <drools:metaData name="elementname">
            <drools:metaValue><![CDATA[Move with Letho]]></drools:metaValue>
          </drools:metaData>
          <drools:onEntry-script scriptFormat="http://www.java.com/java">
            <drools:script><![CDATA[kcontext.setVariable("helpLetho", false);]]></drools:script>
          </drools:onEntry-script>
          <drools:onExit-script scriptFormat="http://www.java.com/java">
            <drools:script><![CDATA[kcontext.setVariable("helpLetho", true);]]></drools:script>
          </drools:onExit-script>
        </bpmn2:extensionElements>
