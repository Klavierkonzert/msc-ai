      <bpmn2:textAnnotation id="_D843D543-9132-42B6-934D-FFC3E916E9BE" name="`helpLetho` set false at the entry of the task, and set true at the end. Thus, if the timer expires, the false value is used to result into preliminary quest completion">
        <bpmn2:extensionElements>
          <drools:metaData name="elementname">
            <drools:metaValue><![CDATA[`helpLetho` set false at the entry of the task, and set true at the end. Thus, if the timer expires, the false value is used to result into preliminary quest completion]]></drools:metaValue>
