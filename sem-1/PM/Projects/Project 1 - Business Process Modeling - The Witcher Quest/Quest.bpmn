      <bpmn2:userTask id="_CF383AA0-BD16-4410-9712-D89F8682EBB1" name="Fight headhunters (+50xp)">
        <bpmn2:documentation id="_i-4bM0ikEfGDnvGeD6FIDw"><![CDATA[Suddenly, men approach the farmstead - clearly no ordinary lost peasants. Letho explains that only one man, a supposed friend, knew where he was, Louis. No matter your choice, he'll basically drag you into the fight so you have to help kill the headhunters. (50XP earned based on the Story and Swords! difficulty level)]]></bpmn2:documentation>
        <bpmn2:extensionElements>
          <drools:metaData name="elementname">
            <drools:metaValue><![CDATA[Fight headhunters (+50xp)]]></drools:metaValue>
          </drools:metaData>
          <drools:onExit-script scriptFormat="http://www.java.com/java">
            <drools:script><![CDATA[com.myspace.witcherquest.Quest q =
    (com.myspace.witcherquest.Quest) kcontext.getVariable("quest");

q.incTotalReward(50);]]></drools:script>
          </drools:onExit-script>
        </bpmn2:extensionElements>
